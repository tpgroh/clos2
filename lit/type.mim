// RUN: %mim -I %S %s -o -

// A polymorphic extern with a `*`-typed parameter but a closed return type; a regression guard that the pipeline survives type arguments.

plugin core;

import pipeline;

use core.ops.s.w;

// TODO: the return type must not depend on T, otherwise the call using ret doesn't work.

extern fun poly_first (T:*, v:«2;T») : I32 = return 0I32;

extern fun test(argc: I32): I32 =
    ret x = poly_first $ (I32, (argc, argc));
    return x;
