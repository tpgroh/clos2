// UNSUPPORTED: always
// RUN: %mim -I %S %s -o -

plugin compile;
plugin clos2;
plugin cps;
plugin mem;

// [pipeline]
extern lam _compile(): compile.Phase =
    compile.phases ff (
        // everything should be in CPS
        compile.named "cps.conv",

        // I require that a lambda or a return continuation can only be used Known or Unknown (First class uses)
        // eta_conv only handles lambdas, thus we also require ret_wrap to run.
        // ret_wrap has to run after eta_conv because eta_conv would undo ret_wrap
        compile.eta_conv,
        compile.ret_wrap,
        
        // I will sometimes require mem.M so I make sure to have those
        compile.named "mem.add_mem",

        // this is my actual pipeline
        compile.named "clos2.hoist_up",
        compile.named "clos2.absclos_to_sjlj",
        compile.named "clos2.absclos_elim",
    );
// [pipeline]
