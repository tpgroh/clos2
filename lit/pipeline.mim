// UNSUPPORTED: always
// RUN: %mim -I %S %s -o -

plugin compile;
plugin clos2;
plugin cps;

// define a custom pipeline for optimization
extern lam _compile(): compile.Phase =
    compile.phases ff (
        // in general I want to perform cps.conv before anything else.
        // TODO: uncomment
        compile.named "cps.conv",

        compile.named "clos2.hoist_up",

        // lambda lift free vars in the type of lambdas.
        // this ensures that lambdas dont have free vars in their type, as required by clos_conv
        compile.named "clos2.lam_lift_type",

        // closure convert every lambda.
        //compile.named "clos2.clos_conv",
    );
