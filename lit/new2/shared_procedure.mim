// RUN: %mim -I %S/.. %s -o - | %FileCheck %s

// `shared` is referenced only from the bodies of two sibling closures, which are finalized in separate scopes.
// The Rewriter's mapping for `shared` dies in between, so outerlams_ is the only thing preventing a second procedure.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

let F = Cn [mem.M 0, I32, Cn [mem.M 0, I32]];

con run2 (m: mem.M 0, f g: F, return: Cn [mem.M 0, I32]) =
    f (m, 1I32, cn (m: mem.M 0, a: I32) = g (m, a, return));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    con shared (m: mem.M 0, x: I32, k: Cn [mem.M 0, I32]) = k (m, x + argc);

    con f1 (m: mem.M 0, x: I32, k: Cn [mem.M 0, I32]) = shared (m, x + 1I32, k);
    con f2 (m: mem.M 0, x: I32, k: Cn [mem.M 0, I32]) = shared (m, x * 2I32, k);

    run2 (m, f1, f2, return);

// every abstract closure must be eliminated by clos2.absclos_elim
// CHECK-NOT: clos2.anno
