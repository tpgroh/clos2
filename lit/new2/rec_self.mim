// RUN: %mim -I %S/.. %s -o - | %FileCheck %s

// A self-recursive closure that escapes: `down` captures `step` and calls itself.
// The only test of procedure_dom's `Cn procedure_dom` self-reference - Requirement 7,
// recursive calls without reallocating the closure.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

let F = Cn [mem.M 0, I32, Cn [mem.M 0, I32]];

con make_countdown (m: mem.M 0, step: I32, return: Cn [mem.M 0, F]) =
    con down (m: mem.M 0, x: I32, k: Cn [mem.M 0, I32]) =
        con done (m: mem.M 0) = k (m, x);
        con more (m: mem.M 0) = down (m, x - step, k);
        (done, more)#(x > 0I32) m;
    return (m, down);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    make_countdown (m, 1I32, cn (m: mem.M 0, f: F) = f (m, argc, return));

// every abstract closure must be eliminated by clos2.absclos_elim
// CHECK-NOT: clos2.anno
