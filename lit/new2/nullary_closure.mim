// RUN: %mim -I %S/.. %s -o - | %FileCheck %s

// An escaping closure whose argument type is `[]`, so inner_lam->var() yields `()` rather than a Var
// and procedure_dom's `arg` component is empty.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

con make_tick (m: mem.M 0, x: I32, k: Cn I32, return: Cn [mem.M 0, Cn []]) =
    con tick () = k x;
    return (m, tick);

extern con entry (m: mem.M 0, x: I32, return: Cn [mem.M 0, I32]) =
    con done (y: I32) = return (m, y);
    make_tick (m, x, done, cn (m: mem.M 0, t: Cn []) = t ());

// every abstract closure must be eliminated by clos2.absclos_elim
// CHECK-NOT: clos2.anno
