// RUN: %mim -I %S/.. %s -o - | %FileCheck %s

// A single free var whose type is an aggregate: `fvs.size() == 1`, but the environment has two projections.
// Pins the `environment.size() == 1` special case against the `proj(num_projs(), i)` path.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

let F = Cn [mem.M 0, I32, Cn [mem.M 0, I32]];

con wrap (m: mem.M 0, p: [I32, I32], return: Cn [mem.M 0, F]) =
    con add_both (m: mem.M 0, x: I32, k: Cn [mem.M 0, I32]) =
        let (a, b) = p;
        k (m, x + a + b);
    return (m, add_both);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    wrap (m, (argc, 7I32), cn (m: mem.M 0, f: F) = f (m, 1I32, return));

// every abstract closure must be eliminated by clos2.absclos_elim
// CHECK-NOT: clos2.anno
