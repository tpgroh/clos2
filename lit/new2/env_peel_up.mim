// RUN: %mim -I %S/.. %s -o - | %FileCheck %s

// `esc` uses every component of `host`'s parameter, so EXAnalysis peels the extracts up to the bare var.
// The resulting environment is a single free var of aggregate type.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

let F = Cn [mem.M 0, I32, Cn [mem.M 0, I32]];

con run (m: mem.M 0, f: F, x: I32, return: Cn [mem.M 0, I32]) = f (m, x, return);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    con host (a b: I32) =
        con esc (m: mem.M 0, x: I32, k: Cn [mem.M 0, I32]) = k (m, x + a + b);
        run (m, esc, 1I32, return);
    host (argc, 2I32);

// every abstract closure must be eliminated by clos2.absclos_elim
// CHECK-NOT: clos2.anno
