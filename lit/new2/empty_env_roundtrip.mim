// RUN: %mim -I %S/.. %s -o - | %FileCheck %s

// A closed `con` used as a value: packed with an empty environment, stored, loaded and called.
// Closed lams are hoisted incidentally elsewhere, but never deliberately packed and re-invoked.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

let F = Cn [mem.M 0, I32, Cn [mem.M 0, I32]];

con ident (m: mem.M 0, x: I32, k: Cn [mem.M 0, I32]) = k (m, x);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let (m, slot) = mem.alloc (F, 0) m;
    let m         = mem.store (m, slot, ident);
    let (m, f)    = mem.load (m, slot);
    f (m, argc, return);

// every abstract closure must be eliminated by clos2.absclos_elim
// CHECK-NOT: clos2.anno
