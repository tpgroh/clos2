// RUN: %mim -I %S/.. %s -o - | %FileCheck %s

// Two mutually recursive closures that both escape, packed into one tuple.
// Crosses the hoist boundary, so the free-var analysis' cycle cache, outerlams_ and the worklist interact.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

let F = Cn [mem.M 0, I32, Cn [mem.M 0, I32]];

con make_parity (m: mem.M 0, off: I32, return: Cn [mem.M 0, [F, F]]) =
    mutual
    con even (m: mem.M 0, x: I32, k: Cn [mem.M 0, I32]) =
        con done (m: mem.M 0) = k (m, off);
        con step (m: mem.M 0) = odd (m, x - 1I32, k);
        (done, step)#(x > 0I32) m;
    con odd (m: mem.M 0, x: I32, k: Cn [mem.M 0, I32]) =
        con done (m: mem.M 0) = k (m, off + 1I32);
        con step (m: mem.M 0) = even (m, x - 1I32, k);
        (done, step)#(x > 0I32) m;
    end;

    return (m, (even, odd));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    make_parity (m, argc, cn (m: mem.M 0, p: [F, F]) =
        let (e, o) = p;
        e (m, 4I32, return));

// every abstract closure must be eliminated by clos2.absclos_elim
// CHECK-NOT: clos2.anno
