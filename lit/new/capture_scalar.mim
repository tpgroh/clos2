// RUN: %mim -I %S/.. %s -o - | %FileCheck %s

// A single-element environment - the `fvs.size() == 1` path, where the environment is the captured value itself rather than a tuple.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

let F = Cn [mem.M 0, I32, Cn [mem.M 0, I32]];

con apply (m: mem.M 0, f: F, x: I32, return: Cn [mem.M 0, I32]) = f (m, x, return);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    con add_argc (m: mem.M 0, x: I32, return: Cn [mem.M 0, I32]) = return (m, x + argc);
    apply (m, add_argc, 10I32, return);

// every abstract closure must be eliminated by clos2.absclos_elim
// CHECK-NOT: clos2.anno
