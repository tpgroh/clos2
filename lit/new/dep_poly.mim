// RUN: %mim -I %S/.. %s -o -

// Free type variables: closures whose types and environments mention a captured `T: *`.

plugin core;
plugin mem;
import pipeline;

lam Thunk (T: *): * = Cn [mem.M 0, Cn [mem.M 0, T]];

con twice {T: *} (m: mem.M 0, f: Cn [mem.M 0, T, Cn [mem.M 0, T]], x: T, return: Cn [mem.M 0, T]) =
    f (m, x, cn (m: mem.M 0, y: T) = f (m, y, return));

extern con store_thunk (T: *, m: mem.M 0, x: T, out: mem.Ptr0 (Thunk T), return: Cn [mem.M 0]) =
    con get (m: mem.M 0, k: Cn [mem.M 0, T]) = k (m, x);
    return (mem.store (m, out, get));

extern con store_thunk_at (T: *, n: Nat, m: mem.M 0, x: T, i: Idx n, arr: mem.Ptr0 «n; Thunk T», return: Cn [mem.M 0]) =
    con get (m: mem.M 0, k: Cn [mem.M 0, T]) = k (m, x);
    return (mem.store (m, mem.lea (arr, i), get));

extern con const_twice (T: *, m: mem.M 0, x y: T, return: Cn [mem.M 0, T]) =
    con const_x (m: mem.M 0, _: T, k: Cn [mem.M 0, T]) = k (m, x);
    twice (m, const_x, y, return);

extern con swap_twice (T: *, m: mem.M 0, p: [T, T], return: Cn [mem.M 0, [T, T]]) =
    con swap (m: mem.M 0, q: [T, T], k: Cn [mem.M 0, [T, T]]) =
        let (a, b) = q;
        k (m, (b, a));
    twice (m, swap, p, return);

extern con poly_vec (T: *, n: Nat, m: mem.M 0, v: «n; T», out: mem.Ptr0 (Cn [mem.M 0, Idx n, Cn [mem.M 0, T]]), return: Cn [mem.M 0]) =
    con at (m: mem.M 0, i: Idx n, k: Cn [mem.M 0, T]) = k (m, v#i);
    return (mem.store (m, out, at));
