// RUN: %mim -I %S/.. %s -o -

// The closures' own types are dependent: the continuation's domain depends on the argument `k`.

plugin core;
plugin mem;
import pipeline;

extern con store_fill (m: mem.M 0, x: I32, out: mem.Ptr0 (Cn [mem.M 0, k: Nat, Cn [mem.M 0, «k; I32»]]), return: Cn [mem.M 0]) =
    con fill (m: mem.M 0, k: Nat, cont: Cn [mem.M 0, «k; I32»]) = cont (m, ‹k; x›);
    return (mem.store (m, out, fill));

extern con store_fill_idx (m: mem.M 0, n: Nat, i: Idx n, out: mem.Ptr0 (Cn [mem.M 0, k: Nat, Cn [mem.M 0, «k; Idx n»]]), return: Cn [mem.M 0]) =
    con fill (m: mem.M 0, k: Nat, cont: Cn [mem.M 0, «k; Idx n»]) = cont (m, ‹k; i›);
    return (mem.store (m, out, fill));
