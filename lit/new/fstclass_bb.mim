// RUN: %mim -I %S/.. %s -o -

// Basic blocks as first-class values: stored to memory, loaded back, and selected by a runtime branch.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

con choose (m: mem.M 0, c: Bool, a b: Cn [mem.M 0]) = (b, a)#c m;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let x = argc + 1I32;
    con on_true  (m: mem.M 0) = return (m, x);
    con on_false (m: mem.M 0) = return (m, x * 2I32);

    let (m, slot) = mem.alloc (Cn [mem.M 0], 0) m;
    let m         = mem.store (m, slot, on_true);
    let (m, k)    = mem.load (m, slot);
    choose (m, argc == 1I32, k, on_false);
