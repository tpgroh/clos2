// RUN: %mim -I %S/.. %s -o -

// Mutual recursion: `even`/`odd` capture `off` and `return`, exercising the cycle breaking in both the free-var analysis and the worklist.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let off = argc * 10I32;

    mutual
    con even (m: mem.M 0, n: I32) =
        (odd_step, done)#(n == 0I32) m
        where
            con done     (m: mem.M 0) = return (m, off);
            con odd_step (m: mem.M 0) = odd (m, n - 1I32);
        end;
    con odd (m: mem.M 0, n: I32) =
        (even_step, done)#(n == 0I32) m
        where
            con done      (m: mem.M 0) = return (m, off + 1I32);
            con even_step (m: mem.M 0) = even (m, n - 1I32);
        end;
    end;

    even (m, argc + 4I32);
