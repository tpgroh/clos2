// RUN: %mim -I %S/.. %s -o -

// Implicit dependent binders that only show up in the types of local closures.

plugin core;
plugin mem;
import pipeline;

con with_idx {n: Nat} (m: mem.M 0, i: Idx n, out: mem.Ptr0 (Cn [mem.M 0, Cn [mem.M 0, Idx n]]), return: Cn [mem.M 0]) =
    con get (m: mem.M 0, k: Cn [mem.M 0, Idx n]) = k (m, i);
    return (mem.store (m, out, get));

extern con entry (m: mem.M 0, n: Nat, i: Idx n, out: mem.Ptr0 (Cn [mem.M 0, Cn [mem.M 0, Idx n]]), return: Cn [mem.M 0]) =
    with_idx (m, i, out, return);

extern con entry_lit (m: mem.M 0, out: mem.Ptr0 (Cn [mem.M 0, Cn [mem.M 0, Idx 5]]), return: Cn [mem.M 0]) =
    with_idx (m, 3₅, out, return);
