// RUN: %mim -I %S/.. %s -o - | %FileCheck %s

// Non-local exit: a loop escapes through a `found` continuation supplied by its caller.

plugin core;
plugin mem;
import pipeline;

use core.ops.u.w;

con find (m: mem.M 0, arr: mem.Ptr0 «8; I32», key: I32, found: Cn [mem.M 0, I32], return: Cn [mem.M 0]) =
    con loop (m: mem.M 0, i: I32) =
        con check (m: mem.M 0) =
            let (m, v) = mem.load (m, mem.lea (arr, core.conv.u 8 i));
            con hit  (m: mem.M 0) = found (m, i);
            con next (m: mem.M 0) = loop (m, i + 1I32);
            (next, hit)#(v == key) m;
        (return, check)#(i < 8I32) m;
    loop (m, 0I32);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let (m, arr) = mem.alloc («8; I32», 0) m;

    con found     (m: mem.M 0, i: I32) = return (m, i + 100I32);
    con not_found (m: mem.M 0)         = return (m, 0I32);

    con fill (m: mem.M 0, i: I32) =
        con store (m: mem.M 0) = fill (mem.store (m, mem.lea (arr, core.conv.u 8 i), i * 3I32), i + 1I32);
        con done  (m: mem.M 0) = find (m, arr, argc * 9I32, found, not_found);
        (done, store)#(i < 8I32) m;

    fill (m, 0I32);

// every abstract closure must be eliminated by clos2.absclos_elim
// CHECK-NOT: clos2.anno
