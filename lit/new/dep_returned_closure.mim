// RUN: %mim -I %S/.. %s -o -

// A closure is returned whose type depends on the creator's argument, once directly and once packed with it.

plugin core;
plugin mem;
import pipeline;

lam Getter (n: Nat): * = Cn [mem.M 0, Idx n, Cn [mem.M 0, I32]];

con make_getter (m: mem.M 0, n: Nat, arr: mem.Ptr0 «n; I32», return: Cn [mem.M 0, Getter n]) =
    con get (m: mem.M 0, i: Idx n, k: Cn [mem.M 0, I32]) = k (mem.load (m, mem.lea (arr, i)));
    return (m, get);

con make_packed (m: mem.M 0, n: Nat, arr: mem.Ptr0 «n; I32», return: Cn [mem.M 0, [k: Nat, Getter k]]) =
    con get (m: mem.M 0, i: Idx n, k: Cn [mem.M 0, I32]) = k (mem.load (m, mem.lea (arr, i)));
    return (m, (n, get));

extern con use_getter (m: mem.M 0, n: Nat, arr: mem.Ptr0 «n; I32», i: Idx n, return: Cn [mem.M 0, I32]) =
    make_getter (m, n, arr, cn (m: mem.M 0, g: Getter n) = g (m, i, return));

extern con store_getter (m: mem.M 0, n: Nat, arr: mem.Ptr0 «n; I32», out: mem.Ptr0 (Getter n), return: Cn [mem.M 0]) =
    make_getter (m, n, arr, cn (m: mem.M 0, g: Getter n) = return (mem.store (m, out, g)));

extern con store_packed (m: mem.M 0, n: Nat, arr: mem.Ptr0 «n; I32», out: mem.Ptr0 [k: Nat, Getter k], return: Cn [mem.M 0]) =
    make_packed (m, n, arr, cn (m: mem.M 0, p: [k: Nat, Getter k]) = return (mem.store (m, out, p)));
