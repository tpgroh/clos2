// RUN: %mim -I %S/.. %s -o - | %FileCheck %s

// `ident` has no free value vars; `n` only occurs in its type.

plugin core;
plugin mem;
import pipeline;

lam IdxFn (n: Nat): * = Cn [mem.M 0, Idx n, Cn [mem.M 0, Idx n]];

con apply {n: Nat} (m: mem.M 0, f: IdxFn n, i: Idx n, return: Cn [mem.M 0, Idx n]) = f (m, i, return);

extern con store_ident (m: mem.M 0, n: Nat, out: mem.Ptr0 (IdxFn n), return: Cn [mem.M 0]) =
    con ident (m: mem.M 0, j: Idx n, k: Cn [mem.M 0, Idx n]) = k (m, j);
    return (mem.store (m, out, ident));

extern con call_ident (m: mem.M 0, n: Nat, i: Idx n, return: Cn [mem.M 0, Idx n]) =
    con ident (m: mem.M 0, j: Idx n, k: Cn [mem.M 0, Idx n]) = k (m, j);
    apply (m, ident, i, return);

// every abstract closure must be eliminated by clos2.absclos_elim
// CHECK-NOT: clos2.anno
